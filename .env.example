# Local SQLite
DATABASE_URL=sqlite:./data/clashdash.sqlite

# PostgreSQL / Vercel alternative
# DATABASE_URL=postgres://user:password@host:5432/clashdash

# At least 32 UTF-8 bytes
CLASHDASH_JWT_SECRET=replace-with-at-least-32-random-characters

# Exactly 32 random bytes encoded as base64url:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CLASHDASH_TOKEN_KEY=replace-with-a-32-byte-base64url-key

# Optional dedicated key for encrypted TOTP secrets. Defaults to CLASHDASH_TOKEN_KEY.
# CLASHDASH_TOTP_KEY=replace-with-another-32-byte-base64url-key

# Optional external scheduler endpoint secret
CLASHDASH_CRON_SECRET=replace-with-an-independent-random-secret

PORT=3000

# The sole administrator is created automatically when the users table is empty.
CLASHDASH_ADMIN_USERNAME=admin
CLASHDASH_ADMIN_PASSWORD=replace-with-any-non-empty-password
