# Postgres connection string. Required in production (Neon / Supabase).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Password for the single admin user.
ADMIN_PASSWORD=change-me

# Secret used to sign the login session (at least 32 random characters).
JWT_SECRET=replace-with-a-long-random-string

# Secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-another-random-string
