# Postgres connection string. Required in production (Neon / Supabase).
# Leave unset locally to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Password used only when initializing the single admin user. After initialization,
# change the password in Settings; changing this variable has no effect on an existing user.
ADMIN_INITIAL_PASSWORD=change-me

# Optional one-shot recovery password. While this variable is set, the whole service is locked:
# the first start/request resets the admin password, deletes TOTP, and invalidates existing
# sessions (only once — a marker prevents repeated resets). Remove the variable and
# redeploy/restart to unlock, then sign in with this password. Do NOT set it before the
# database has been initialized.
# ADMIN_OVERRIDE_PASSWORD=

# Secret used to sign the login session (at least 32 random characters).
JWT_SECRET=replace-with-a-long-random-string

# Login session lifetime in seconds (default: 86400 = 24 hours).
# JWT_SESSION_TTL=86400

# Secret your manually configured cron job sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-another-random-string

# Optional Cloudflare Turnstile keys. When both are set, the login form requires a Turnstile
# challenge, which protects password and TOTP guessing against bots. Without them the login
# endpoint has no hard rate limit.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Optional comma-separated allowlist of hostnames accepted in siteverify responses
# (e.g. your production domain). Never include localhost in a production value.
# TURNSTILE_HOSTNAMES=

# Subscription fetching guards. By default subscriptions pointing at loopback/private/reserved
# addresses are refused (SSRF protection); set to 1 if your subscription converter lives on your LAN.
# SUBSCRIPTION_ALLOW_PRIVATE_NETWORK=
# Response size cap for subscription bodies in bytes (default: 10485760 = 10MB).
# SUBSCRIPTION_MAX_BYTES=
