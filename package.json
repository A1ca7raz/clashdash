{
  "name": "clashdash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run ui",
    "test:sqlite": "vitest run src/infrastructure/store/sqlite",
    "test:postgres": "vitest run tests/integration/store-contract.postgres.test.ts",
    "test:e2e": "npm run build && playwright test",
    "build:server": "tsup src/server/main.ts --format esm --platform node --target node24 --external better-sqlite3 --external postgres --out-dir dist/server --clean",
    "build:ui": "vite build",
    "build": "npm run typecheck && npm run build:server && npm run build:ui",
    "migrate": "tsx scripts/migrate.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@dnd-kit/core": "latest",
    "@dnd-kit/sortable": "latest",
    "@dnd-kit/utilities": "latest",
    "@hono/node-server": "latest",
    "@hono/zod-validator": "latest",
    "@tanstack/react-query": "latest",
    "drizzle-orm": "latest",
    "hono": "latest",
    "jose": "latest",
    "node-cron": "latest",
    "postgres": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/node-cron": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "jsdom": "latest",
    "tailwindcss": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
